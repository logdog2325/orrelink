 {
   std::lock_guard lock(s_mutex);
@@ -554,9 +190,6 @@ void OnDeviceCreated()
   PruneOldLogs(dir);
   s_session_stamp = Timestamp("%Y%m%d_%H%M%S");
   s_path = dir + "gba_detect_" + s_session_stamp + ".log";
-  s_battle.clear();
-  for (auto& building : s_battle_building)
-    building.reset();
   s_file.close();
   s_file.clear();
   s_file.open(s_path, std::ios::out | std::ios::trunc);
@@ -606,7 +239,7 @@ void OnDeviceDestroyed()
       s_trace.flush();
       s_trace.close();
     }
-    WriteBattleTranscript();
+    XDBattleRecorder::Finish();
