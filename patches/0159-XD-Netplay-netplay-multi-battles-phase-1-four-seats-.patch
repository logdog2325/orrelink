+  const bool solo = !netplay_now && !movie.IsPlayingInput();
+  Sample sample;
+  GCPadStatus gl{};
+  if (!netplay_now)
+    sample.pad = Pad::GetStatus(m_device_number);
+  if (solo)
+    gl = Pad::GetGBAStatus(m_device_number);
