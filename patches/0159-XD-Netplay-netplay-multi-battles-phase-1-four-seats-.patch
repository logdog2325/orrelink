+    sample.keys = CSIDevice_GBAEmu::GbaKeysFromPad(gl) & 0x3FF;
+    sample.reset = (gl.button & PAD_BUTTON_X) != 0;
+  }
+  m_last_buttons = sample.pad.button;
+  return sample;
