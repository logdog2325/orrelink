+      FormatRules::FormatFixedLevel(Config::Get(Config::MAIN_XD_FORMAT)) == 100)
+  {
+    raised = MonFactory::RaisePartyToLevel100(built, data);
+  }
+
+  const size_t count = built.size();
+  if (!save.WriteParty(built))
+    return fail("party too large");
