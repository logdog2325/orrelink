diff --git a/Source/Core/Core/NetPlayClient.cpp b/Source/Core/Core/NetPlayClient.cpp
index 1e54069..d1e37db 100644
--- a/Source/Core/Core/NetPlayClient.cpp
+++ b/Source/Core/Core/NetPlayClient.cpp
@@ -2467,6 +2467,14 @@ void NetPlayClient::SendTeamSubmission(const std::string& payload)
   SendAsync(std::move(packet));
 }
 
+void NetPlayClient::SendXdReady()
+{
+  sf::Packet packet;
+  packet << MessageID::XdReady;
+
+  SendAsync(std::move(packet));
+}
+
 void NetPlayClient::SendXdWatch(bool watching)
 {
   sf::Packet packet;
diff --git a/Source/Core/Core/NetPlayClient.h b/Source/Core/Core/NetPlayClient.h
index d3ecbba..e62aea1 100644
--- a/Source/Core/Core/NetPlayClient.h
+++ b/Source/Core/Core/NetPlayClient.h
@@ -214,6 +214,7 @@ public:
   // XD Netplay: this player only watches (true) or wants to play (false). Takes effect at the
   // next Start; the server answers with XdSeats.
   void SendXdWatch(bool watching);
+  void SendXdReady();
   // XD Netplay: pid's part in the next battle, from the last XdSeats. Display only; the pad map
   // is decided by the host at Start. Takes m_crit.players.
   XdRole GetXdRole(PlayerId pid);
diff --git a/Source/Core/Core/NetPlayProto.h b/Source/Core/Core/NetPlayProto.h
index 7549f8e..7612440 100644
--- a/Source/Core/Core/NetPlayProto.h
+++ b/Source/Core/Core/NetPlayProto.h
@@ -256,6 +256,9 @@ enum class MessageID : u8
   // clients: u8 XdNoticeKind, PlayerId who, u8 arg. Each client writes the line itself, into the
   // room chat only, never on screen.
   XdNotice = 0xAC,
+  // XD Netplay: client -> server, no payload. A seated joiner is ready; the host's Start waits
+  // for every one of them, and each Start clears it.
+  XdReady = 0xAD,
 
   TimeBase = 0xB0,
   DesyncDetected = 0xB1,
diff --git a/Source/Core/Core/NetPlayServer.cpp b/Source/Core/Core/NetPlayServer.cpp
index 210f6fe..36bb8b1 100644
--- a/Source/Core/Core/NetPlayServer.cpp
+++ b/Source/Core/Core/NetPlayServer.cpp
@@ -1508,6 +1508,18 @@ unsigned int NetPlayServer::OnData(sf::Packet& packet, Client& player)
   }
   break;
 
+  case MessageID::XdReady:
+  {
+    bool added;
+    {
+      std::lock_guard lk(m_xd_ready_mutex);
+      added = m_xd_ready.insert(player.pid).second;
+    }
+    if (added)
+      SendChatMessage(player.name + " is ready.");
+  }
+  break;
+
   case MessageID::ChunkedDataProgress:
   {
     u32 cid;
@@ -2690,6 +2702,11 @@ bool NetPlayServer::StartGame()
   // Running goes up before pending comes down: see IsStartingOrRunning().
   m_is_running = true;
   m_start_pending = false;
+  {
+    // Every battle asks again.
+    std::lock_guard lk(m_xd_ready_mutex);
+    m_xd_ready.clear();
+  }
 
   return true;
 }
@@ -3471,6 +3488,24 @@ void NetPlayServer::SendXdSeats()
 }
 
 // called from ---GUI--- thread
+std::string NetPlayServer::XdNotReadyRefusal()
+{
+  std::set<PlayerId> ready;
+  {
+    std::lock_guard lk(m_xd_ready_mutex);
+    ready = m_xd_ready;
+  }
+  std::string names;
+  std::lock_guard lkp(m_crit.players);
+  for (const Client& client : std::views::values(m_players))
+  {
+    if (client.IsHost() || client.xd_seat < 2 || client.xd_watching || ready.contains(client.pid))
+      continue;
+    names += (names.empty() ? "" : ", ") + client.name;
+  }
+  return names.empty() ? std::string{} : "Waiting for " + names + " to press Ready.";
+}
