+void SetTeams(std::vector<TeamMember> side1, std::vector<TeamMember> side2)
+{
+  std::lock_guard lock(s_teams_mutex);
+  s_teams = {std::move(side1), std::move(side2)};
+}
+
+void ClearTeams()
+{
+  std::lock_guard lock(s_teams_mutex);
+  s_teams = {};
+}
