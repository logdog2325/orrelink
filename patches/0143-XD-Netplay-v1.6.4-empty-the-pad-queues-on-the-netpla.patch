From 7eee3f2f7e34415ad26101d8f279b3f452cc4d54 Mon Sep 17 00:00:00 2001
From: logdog2325 <226450061+logdog2325@users.noreply.github.com>
Date: Tue, 22 Sep 2026 18:36:42 -0700
Subject: [PATCH] XD Netplay v1.6.4: empty the pad queues on the netplay
 thread, so a new game cannot throw away input that already arrived

The clear lived in NetPlayClient::StartGame, which Qt runs on the GUI thread:
NetPlayDialog::OnMsgStartGame posts it with QueueOnObject and returns, while
the netplay thread keeps taking packets. OnPadData pushes whatever arrives
with no gate, so the first PadData packet of the new game, which carries the
sender's whole initial fill of buffer size + 1 entries for every pad it owns,
landed in the queues and was then discarded by that late clear.

The victim's copies of the sender's pads then ran one full fill ahead of the
owner's for the rest of the session. Two consequences, both seen in the
2026-09-22 logs of a session played between an Android host and a Windows
joiner:

 - The GBA cores desynced. A netplay GBA reset is carried by the owner putting
   the X button into its own pad stream, so every machine resets that core at
   the same poll. With the streams 21 entries apart the joiner reset its copy
   of the host's GBA 21 polls early, linked it 21 polls early, and from there
   the two copies of the same GBA drifted. At the team pick one machine had
   four picks and the other had one.
 - The link crawled. Each side may normally run up to buffer size polls ahead
   of the other, so a round trip has twice the buffer to hide in. Shifted, one
   side has no slack at all and the pair advances 19 polls per round trip
   instead of 40. At the session's 266 ms ping that is about half speed, on a
   link the 20 frame buffer covers comfortably.

The clear now happens in NetPlayClient::OnStartGame on the netplay thread,
before the UI is told to boot. StartGame and PadData ride the same ordered
channel, so the clear is ordered before any pad data of the new game on every
platform. StartGame keeps a guarded clear for a path that arrives without the
message. The Android host already ran StartGame on the netplay thread, which
is why only the joiner lost its fill.

New "padpop" line in the session log: the depth of each pad queue at its first
pop of a game. A pad this machine does not own reads depth = buffer size + 1;
a depth of 1 on such a pad is this fault, visible in the first second.
---
 Source/Core/Core/NetPlayClient.cpp       | 47 ++++++++++++++++++++++--
 Source/Core/Core/NetPlayClient.h         |  7 ++++
 Source/Core/UICommon/XDNetplay/Version.h |  2 +-
 3 files changed, 52 insertions(+), 4 deletions(-)

diff --git a/Source/Core/Core/NetPlayClient.cpp b/Source/Core/Core/NetPlayClient.cpp
index 28c371f..2d27905 100644
--- a/Source/Core/Core/NetPlayClient.cpp
+++ b/Source/Core/Core/NetPlayClient.cpp
@@ -1105,6 +1105,22 @@ void NetPlayClient::OnStartGame(sf::Packet& packet)
     m_net_settings.is_hosting = m_local_player->IsHost();
   }
 
+  // Empty the pad queues HERE, on the netplay thread, in message order, before the UI is told to
+  // boot. The clear used to live in StartGame(), which Qt runs later on the GUI thread
+  // (NetPlayDialog::OnMsgStartGame posts it with QueueOnObject) while this thread keeps taking
+  // packets: OnPadData pushes whatever arrives, ungated, so the first PadData packet of the new
+  // game (the sender's whole initial fill, buffer size + 1 entries for each pad it owns) landed in
+  // the queues and was then discarded by that late clear. The victim's copies of those pads ran
+  // one full fill ahead of the owner's for the rest of the session: every GBA reset and every
+  // button press reached the two machines at different emulated polls, which both desynced the
+  // GBA cores and halved the buffer's round-trip budget, so the game crawled at about half speed
+  // on a link that could carry it. Clearing on this thread orders the clear before any PadData of
+  // the new game on every platform, because both ride the same ordered channel.
+  ClearBuffers();
+  m_first_pad_status_received.fill(false);
+  m_first_pop_logged.fill(false);
+  m_input_reset_for_game.store(true, std::memory_order_release);
+
   m_dialog->OnMsgStartGame();
 }
 
@@ -2022,9 +2038,16 @@ bool NetPlayClient::StartGame(const std::string& path)
   m_is_running.Set();
   NetPlay_Enable(this);
 
-  ClearBuffers();
-
-  m_first_pad_status_received.fill(false);
+  // Normally already done by OnStartGame on the netplay thread, which is the only ordering that
+  // cannot discard input that has already arrived. This is the fallback for a path that reaches
+  // here without that message.
+  if (!m_input_reset_for_game.load(std::memory_order_acquire))
+  {
+    ClearBuffers();
+    m_first_pad_status_received.fill(false);
+    m_first_pop_logged.fill(false);
+  }
+  m_input_reset_for_game.store(false, std::memory_order_relaxed);
 
   if (m_dialog->IsRecording())
   {
@@ -2677,6 +2700,24 @@ bool NetPlayClient::GetNetPads(const int pad_nb, const bool batching, GCPadStatu
     }
   }
 
+#ifdef HAS_LIBMGBA
+  // One line per pad per game: how many entries this pad's queue holds at its first pop. Both an
+  // owned pad (PollLocalPad has just topped it up) and a pad whose owner's opening fill arrived
+  // intact read buffer size + 1. A small depth on a pad this machine does not own means that fill
+  // was lost and this machine will run a whole fill ahead of the owner, the fault behind the
+  // 2026-09-22 desync.
+  if (pad_nb >= 0 && static_cast<size_t>(pad_nb) < m_first_pop_logged.size() &&
+      !m_first_pop_logged[pad_nb])
+  {
+    m_first_pop_logged[pad_nb] = true;
+    const PadDetails details = GetPadDetails(pad_nb);
+    GBADetectLog::LogEvent(0, Core::System::GetInstance().GetCoreTiming().GetTicks(), "padpop",
+                           fmt::format("pad={} depth={} target={} local={}", pad_nb,
+                                       m_pad_buffer[pad_nb].Size(), m_target_buffer_size,
+                                       details.is_local ? 1 : 0));
+  }
+#endif
+
   m_pad_buffer[pad_nb].Pop(*pad_status);
 
   auto& movie = Core::System::GetInstance().GetMovie();
diff --git a/Source/Core/Core/NetPlayClient.h b/Source/Core/Core/NetPlayClient.h
index 23cb274..6231bfc 100644
--- a/Source/Core/Core/NetPlayClient.h
+++ b/Source/Core/Core/NetPlayClient.h
@@ -226,6 +226,13 @@ protected:
 
   std::array<GCPadStatus, 4> m_last_pad_status{};
   std::array<bool, 4> m_first_pad_status_received{};
+  // Set by OnStartGame (netplay thread) once it has emptied the pad queues for the game it is
+  // announcing, so the later StartGame() on the GUI thread does not empty them a second time and
+  // throw away input that has already arrived. See the comment in OnStartGame.
+  // Atomic: written on the netplay thread, read on the GUI thread that boots the game.
+  std::atomic<bool> m_input_reset_for_game{false};
+  // One "padpop" diagnostic line per pad per game: how deep that pad's queue was at its first pop.
+  std::array<bool, 4> m_first_pop_logged{};
 
   std::chrono::time_point<std::chrono::steady_clock> m_buffer_under_target_last;
 
diff --git a/Source/Core/UICommon/XDNetplay/Version.h b/Source/Core/UICommon/XDNetplay/Version.h
index 9ba99b1..50326cb 100644
--- a/Source/Core/UICommon/XDNetplay/Version.h
+++ b/Source/Core/UICommon/XDNetplay/Version.h
@@ -11,5 +11,5 @@ namespace XDNetplay
 // fork's release, so it cannot answer "which XD Netplay am I?" -- this constant is the only thing
 // that can. It MUST be bumped in the same patch that a release is tagged from: ship a tag ahead of
 // this string and every user of that release is told they are out of date forever.
-constexpr char VERSION[] = "1.6.3";
+constexpr char VERSION[] = "1.6.4";
 }  // namespace XDNetplay
