<?xml version="1.0" encoding="utf-8"?>
<!-- OrreLink launcher icon: an Orre colosseum facade in desert sandstone.
     All geometry sits inside the 18..90 adaptive-icon safe zone, so no launcher
     mask can clip the arches. The legacy mipmap PNGs are drawn from the same
     coordinates, so the two never drift apart. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- outer wall, domed slightly at the centre -->
    <path
        android:pathData="M23,84 L23,33 Q54,25 85,33 L85,84 Z"
        android:fillColor="#E6B56A" />

    <!-- right third in shadow, so the flat facade reads as a curved ring -->
    <path
        android:pathData="M64,84 L64,29.5 Q75,29.6 85,33 L85,84 Z"
        android:fillColor="#C68F4A" />

    <!-- upper tier -->
    <path android:pathData="M30,56 L30,45 A5,5 0 0 1 40,45 L40,56 Z" android:fillColor="#4A2E16" />
    <path android:pathData="M43,56 L43,45 A5,5 0 0 1 53,45 L53,56 Z" android:fillColor="#4A2E16" />
    <path android:pathData="M56,56 L56,45 A5,5 0 0 1 66,45 L66,56 Z" android:fillColor="#4A2E16" />
    <path android:pathData="M69,56 L69,45 A5,5 0 0 1 79,45 L79,56 Z" android:fillColor="#4A2E16" />

    <!-- cornice -->
    <path android:pathData="M24,57 L84,57 L84,61 L24,61 Z" android:fillColor="#B0793A" />

    <!-- lower tier -->
    <path android:pathData="M30,84 L30,68 A5,5 0 0 1 40,68 L40,84 Z" android:fillColor="#4A2E16" />
    <path android:pathData="M43,84 L43,68 A5,5 0 0 1 53,68 L53,84 Z" android:fillColor="#4A2E16" />
    <path android:pathData="M56,84 L56,68 A5,5 0 0 1 66,68 L66,84 Z" android:fillColor="#4A2E16" />
    <path android:pathData="M69,84 L69,68 A5,5 0 0 1 79,68 L79,84 Z" android:fillColor="#4A2E16" />

    <!-- ground -->
    <path android:pathData="M20,84 L88,84 L88,88 L20,88 Z" android:fillColor="#96632C" />
</vector>
